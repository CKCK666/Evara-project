 <div class="page-header breadcrumb-wrap">
            <div class="container">
                <div class="breadcrumb">
                    <a href="/" rel="nofollow">Home</a>
                    <span></span> Shop
                    <span></span> Order details
                </div>
            </div>
        </div>
        <section class="mt-50 mb-50">
         
            <div class="container">
                
                <div class="row">
                    <div class="col-lg-6 mb-sm-15">
                       {{#if deliveryAddress}}
                        {{#each deliveryAddress}}
                          <div class="card-header">
                          <h5 class="mb-0">Shipping Address</h5> 
                         </div>
                        <div class='card-body'>
                        <address>{{strFullName}}<br />
                          {{strPhoneNo}},<br />
                          {{strCity}}.
                          <br />{{intPinCode}}</address>
                        <p>{{strState}}</p>
                        <p>India</p>
                      
                      </div>
                      {{/each}}
                    {{/if}}
                   
                    </div>
                      {{#if orderDetails}}
                     <div class="col-md-6">
                      
                        <div class="order_review">
                            <div class="mb-20">
                                <h4>Your Orders</h4>
                            </div>
                            <div class="table-responsive order_table text-center">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th colspan="2">Product</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#if orderProducts}}
                                        {{#each orderProducts}}
                                        <tr>
                                            <td class="image product-thumbnail"><img src='/uploads/{{arrayOtherImages.[0]}}' alt="#"></td>
                                            <td>
                                                <h5><a href="shop-product-full.html">{{strDescription}}</a></h5> <span class="product-qty">x {{intQuantity}}</span>
                                            </td>
                                            <td>{{intTotalPrice}}</td>
                                        </tr>
                                        {{/each}}
                                        {{/if}}

                                        {{#if orderDetails}}
                                        {{#each orderDetails}}
                                        <tr>
                                            <th>Order Status</th>
                                            <td class="product-subtotal font-xl" {{#eq strOrderStatus 'Processing'}}style="color: orange"
                            {{else}}{{#eq strOrderStatus 'Delivered'}}style="color: green"
                           {{else}}{{#eq strOrderStatus 'Cancelled'}}style="color: red"
                            {{else}}{{#eq strOrderStatus 'Return Requested'}}style="color: red"
                            {{else}}{{#eq strOrderStatus 'Pending'}}style="color: red"
                            {{/eq}}
                            {{/eq}}
                             {{/eq}}
                             {{/eq}}
                            {{/eq}} colspan="2">{{strOrderStatus}}</td>
                                        </tr>
                                          <tr>
                                            <th>Payment Method</th>
                                            <td class="product-subtotal font-xl" colspan="2">{{strPaymentMethod}}</td>
                                        </tr>
                                        <tr>
                                            <th>SubTotal</th>
                                            <td class="product-subtotal" colspan="2">₹{{intTotalOrderPrice}}</td>
                                        </tr>
                                         <tr>
                                            <th>Total Discount</th>
                                            <td class="product-discount" colspan="2">-₹{{totalDiscount}}</td>
                                        </tr>
                                         <tr>
                                            <th>Coupon Discount</th>
                                            <td class="product-coupon-discount" colspan="2">-₹{{couponDiscount}}</td>
                                        </tr>
                                        <tr>
                                            <th>Wallet cash</th>
                                            <td class="product-coupon-discount" colspan="2">-₹{{walletCashUsed}}</td>
                                        </tr>
                                         <tr>
                                            <th>Gst-(4%)</th>
                                            <td class="product-gst" colspan="2">+₹{{gst}}</td>
                                        </tr>
                                        <tr>
                                            <th>Shipping</th>
                                            <td colspan="2"><em>Free Shipping</em></td>
                                        </tr>
                                        <tr>
                                            <th>Total</th>
                                            <td colspan="2" class="product-subtotal"><span class="font-xl text-brand fw-900">₹{{totalAmountAfterDiscount}}</span></td>
                                        </tr>
                                        {{/each}}
                                        {{/if}}
                                    </tbody>
                                </table>
                            </div>
                            <div class="bt-1 border-color-1 mt-30 mb-30">
                         {{#eq orderDetails.[0].strOrderStatus 'Processing'}}
                         <a href='#' data-pk-order-id="{{orderDetails.[0].pkOrderId}}" data-pk-user-id="{{orderDetails.[0].pkUserId}}" data-order-status-change="Cancelled" class='btn-small d-block cancel-order-btn'>
    <button class='btn btn-fill-out'>Cancel Order</button>
  </a>
{{else}}
 {{#eq orderDetails.[0].strOrderStatus 'Confirmed'}}
 <a href='#' data-pk-order-id="{{orderDetails.[0].pkOrderId}}" data-pk-user-id="{{orderDetails.[0].pkUserId}}" data-order-status-change="Cancelled" class='btn-small d-block cancel-order-btn'>
    <button class='btn btn-fill-out'>Cancel Order</button>
  </a>
  {{else}}
   {{#eq orderDetails.[0].strOrderStatus 'Shipped'}}
 <a href='#' data-pk-order-id="{{orderDetails.[0].pkOrderId}}" data-pk-user-id="{{orderDetails.[0].pkUserId}}" data-order-status-change="Cancelled" class='btn-small d-block cancel-order-btn'>
    <button class='btn btn-fill-out'>Cancel Order</button>
  </a>
  {{else}}
   {{#eq orderDetails.[0].strOrderStatus 'Pending'}}
 <a href='#' data-pk-order-id="{{orderDetails.[0].pkOrderId}}" data-pk-user-id="{{orderDetails.[0].pkUserId}}" data-order-status-change="Cancelled" class='btn-small d-block cancel-order-btn'>
    <button class='btn btn-fill-out'>Cancel Order</button>
  </a>
  
  {{else}}
  {{/eq}}
 {{/eq}}
  {{/eq}}
 {{/eq}}
                         

                           
                               </div>

                               <div class="bt-1 border-color-1 mt-30 mb-30">
                                 {{#eq orderDetails.[0].strOrderStatus 'Pending'}}
                           
                               {{else}}
                               {{#eq orderDetails.[0].strOrderStatus 'Processing'}}
                   
                               {{else}}
                               {{#eq orderDetails.[0].strOrderStatus 'Cancelled'}}
                                 {{#eq orderDetails.[0].strPaymentStatus 'Success'}}
                                 <a onclick="generateInvoice('{{orderDetails.[0].pkOrderId}}')" class="btn btn-md rounded font-sm hover-up "><i class="text-muted material-icons md-post_add"></i>Invoice download</a>
                                 {{/eq}}

                               {{else}}
                               <a onclick="generateInvoice('{{orderDetails.[0].pkOrderId}}')" class="btn btn-md rounded font-sm hover-up "><i class="text-muted material-icons md-post_add"></i>Invoice download</a>
                               {{/eq}}
                               {{/eq}}
                               {{/eq}}
                               
                                 {{#eq orderDetails.[0].strOrderStatus 'Delivered'}}
                               <button  class="btn btn-md rounded font-sm hover-up return-order-btn" data-pk-order-id="{{orderDetails.[0].pkOrderId}}" data-pk-user-id="{{orderDetails.[0].pkUserId}}" data-order-status-change="Return Requested"><i class="text-muted material-icons md-post_add"></i>Return order</button>
                               {{/eq}}
                               </div>
                               
                        </div>
                             
                    </div>
                    {{else}}
                    <div class="col-md-6">
                      <h1>No Orders</h1>
                    </div>
                   {{/if}}   
                    
                                  
                </div>
              
            
                   
                
            </div>
        </section>