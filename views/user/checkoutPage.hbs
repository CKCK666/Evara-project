 <div class="page-header breadcrumb-wrap">
            <div class="container">
                <div class="breadcrumb">
                    <a href="/" rel="nofollow">Home</a>
                    <span></span> Shop
                    <span></span> Checkout
                </div>
            </div>
        </div>
        <section class="mt-50 mb-50">
            <div class="container">
                <div class="col-lg-6">
                        <div class="toggle_info">
                            <span><i class="fi-rs-label mr-10"></i><span class="text-muted"></span> <a href="#coupon" data-bs-toggle="collapse" class="collapsed" aria-expanded="false">Apply coupon</a></span>
                        </div>
                        <div class="panel-collapse collapse coupon_form " id="coupon">
                               <div class="card-body">
                                    <div class="single-form d-flex flex-col gap-3">
                                      {{#if coupons}}
                                      {{#each coupons}}
                                        <div class="col-lg-4">
                                            <div class="coupon" id="couponContainer">
                                                
                                                <h5>{{code}}</h5>
                                                <h6>{{name}}</h6>
                                                <p>Discount: {{discountPercentage}}%</p>
                                                <p>Purchase above Rs.{{minimumSpend}}</p>
                                                <h6>Expiry :{{formatDate expireDate}}<h6>
                                                  
                                                <div class="button-group">
                    <button type="button" class="copy-btn btn btn-primary btn-sm rounded apply-btn" data-id="{{_id}}" data-discount="{{discountPercentage}}" data-minSpend="{{minimumSpend}}" >Apply</button>
                    <button type="button" class="remove-btn btn btn-danger btn-sm rounded" style="display: none;">Remove</button>
                </div>
                                            </div>
                                        </div>
                                        {{/each}}
                                        {{else}}
                                        <h5>No coupons</h5>
                                        {{/if}}

                                     
                                    
                                    <!-- </div>
                                </div>
                            -->
                                    </div>
                           
                       </div>
                        </div>

                      

                      
                    </div>
                <div class="row">
                    {{!-- <p class="info-header">
                    <i class="fa fa-exclamation-circle"></i> 
                    <a data-bs-toggle="collapse" href="#coupon">Apply Coupon</a>
                </p> --}}
                 <div class="collapse" id="coupon">
                 
                </div>
                

                    <div class="col-lg-6 mb-sm-15">
                         
                       {{#if userAddress}}
                       {{#each userAddress}}
                         
                          <div class="card-header">
                            <input type="radio" name="shipping-address" id="shipping-address-{{pkAddressId}}" data-pk-address-id="{{pkAddressId}}" {{#if isDefaultAddress}}checked{{/if}}>
                                                        <h5 class="mb-0">Shipping Address:{{#if isDefaultAddress}}<span style="color:rgb(13, 190, 13);">Default</span>{{/if}}</h5> 
                        </div>
                      <input type="hidden" name="pkAddressId" value={{pkAddressId}}>

                        <div class='card-body'>
                        <address>{{strFullName}}<br />
                          {{strPhoneNo}},<br />
                          {{strCity}}.
                          <br />{{intPinCode}}</address>
                        <p>{{strState}}</p>
                        <p>India</p>
                       <a href='/getEditAddress?pkAddressId={{pkAddressId}}&pkUserId={{pkUserId}}' class='btn-small'>Edit</a>
                   {{#if isDefaultAddress}}  {{else}}     <a href="#" onclick="deleteAddress('{{pkAddressId}}','{{pkUserId}}','toCheckout')" class='btn-small ml-5'>Remove</a>{{/if}}
                       {{!-- {{#if isDefaultAddress}}  {{else}} <a href='#'  data-pk-address-id="{{pkAddressId}}" data-pk-user-id="{{pkUserId}}" data-check-out="toCheckOut" class='btn-small ml-5 set-as-default'>Set as default</a>{{/if}} --}}
                      
                      </div>
                      {{/each}}
                    {{/if}}
                    <a href="/getAddAddress?pkUserId={{pkUserId}}" class="btn btn-primary btn-sm rounded">Add new address</a>
                    
                    </div>


                     <div class="col-md-6">
                        <div class="order_review">
                            <div class="mb-20">
                                <h4>Your Orders</h4>
                            </div>
                            <div class="table-responsive order_table text-center">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th colspan="2">Product</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#if cartProducts}}
                                        {{#each cartProducts}}
                                        <tr>
                                            <td class="image product-thumbnail"><img src="/uploads/{{arrayOtherImages.[0]}}" alt="#"></td>
                                            <td>
                                                <h5><a href="shop-product-full.html">{{strDescription}}</a></h5> <span class="product-qty">{{intPrice}} x {{intQuantity}}</span>
                                            </td>
                                            <td>
                                                <div class="containter10">
                                                     <ul style="list-style-type: none; padding: 0; margin: 0;">
            <li style="padding-bottom: 5px;">Total price: {{intTotalPrice}}</li>
          {{#if offer}}  <li style="padding-bottom: 5px;">Discount: -{{discount}}</li>
            <li style="color: #bd2130;">Discount price: {{totalOfferPrice}}</li>{{/if}}
        </ul>

                                            </td>
                                        </tr>
                                        {{/each}}
                                        {{/if}}

                                        {{#if cartDetails}}
                                       <input type="hidden" name="pkCartId" id="checkout-cartId" value={{cartDetails.[0].pkCartId}}>
                                     
                                        <tr>
                                            <th>Shipping</th>
                                            <td colspan="2"><em>Free Shipping</em></td>
                                        </tr>
                                        <tr>
                                            <th>Total</th>
                                            <td colspan="2" class="product-subtotal totalAmt"><span>₹{{subTotalPrice}}</span></td>
                                        </tr>
                                        {{#if totalDiscountValue}}
                                          <tr>
                                            <th>Discount</th>
                                            <td colspan="2" class="totalDiscount"><span class="text-danger" id="totalDiscountSpan">-{{totalDiscountValue}}</span></td>
                                        </tr>
                                        {{/if}}
                                         <tr>
                                            <th>Coupon reduction</th>
                                            <td colspan="2" class="couponDiscount-checkout"><span class="text-danger" id="couponDiscountSpan">0.00</span></td>
                                        </tr>
                                          <tr>
                                            <th>Gst-(4%)</th>
                                            <td colspan="2" class="gst"><span class="text-danger">+{{gst}}</span></td>
                                        </tr>
                                      
                                        <tr>
                                            <th>Order Total</th>
                                            <td colspan="2" class="product-subtotal grandTotalAmt"><span class="font-xl text-brand fw-900">₹{{totalCartPrice}}</span></td>
                                        </tr>
                                    
                                        {{/if}}
                                    </tbody>
                                </table>
                            </div>
                            <div class="bt-1 border-color-1 mt-30 mb-30"></div>
                            <div class="payment_method">
                                <div class="mb-25">
                                    <h5>Payment</h5>
                                </div>
                              <div class="payment_option">
    <div class="custome-radio">
        <input class="form-check-input" required="" type="radio" name="payment_option" id="codOption" checked="" >
        <label class="form-check-label" for="codOption" data-bs-toggle="collapse" data-target="#codCollapse" aria-controls="codCollapse">COD <span style="color: #bd2130; display:none">(Only for below Rs:1000 purchase)</span></label>
        <div class="form-group collapse in" id="codCollapse">
            <p class="text-muted mt-5">There are many variations of passages of Lorem Ipsum available, but the majority have suffered alteration.</p>
        </div>
    </div>
    <div class="custome-radio">
        <input class="form-check-input" required="" type="radio" name="payment_option" id="razorpayOption">
        <label class="form-check-label" for="razorpayOption" data-bs-toggle="collapse" data-target="#razorpayCollapse" aria-controls="razorpayCollapse">Razorpay</label>
        <div class="form-group collapse in" id="razorpayCollapse">
            <!-- Razorpay button -->
            <button id="razorpay-button" class="btn btn-primary">Pay with Razorpay</button>
        </div>
    </div>
<!-- wallet checkbox -->
      <div class="form-check wallet">
             <input type="checkbox" class="form-check-input" id="walletCheck" name="walletCheckBox">
               <label class="form-check-label" for="exampleCheck1">Wallet balance:
                <span id="walletBalanceSpan" >{{walletBalance}}</span>


               </label>
               </div>
</div>
                            </div>
                          
                             <button id="place-order-btn" class='btn btn-fill-out submit' name='submit' value='Submit'>Order submit</button>
                            <h6 id='errorMessage' style='color: red; text-align: center;font-size:medium;font-weight:normal' ></h6>
                        </div>
                    </div>
                    
                </div>
              
            
                   
                
            </div>
        </section>

        <style>
            .card-header {
    display: flex;
    align-items: center;
}
.btn-danger {
    color: #fff; /* Text color */
    background-color: #dc3545; /* Background color */
    border-color: #dc3545; /* Border color */
}

.btn-danger:hover {
    color: #fff; /* Text color on hover */
    background-color: #c82333; /* Background color on hover */
    border-color: #bd2130; /* Border color on hover */
}

.card-header input[type="radio"] {
      width: 15px; /* Set the width of the radio button */
    height: 15px; 
    margin-right: 10px; /* Adjust margin as needed */
}
             .form-control.error:not(#search-form-control){
        border-color: red;}

        .button-group button {
    width: calc(50% - 5px); /* Set the width to 50% minus the space between buttons */
    margin-right: 5px; /* Set margin-right to create space between buttons */
}

.button-group button:last-child {
    margin-right: 0; /* Remove margin-right for the last button to prevent extra space */
}



   

        </style>