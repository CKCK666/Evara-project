  <section class="content-main">
    <div class="content-header">
      <h2 class="content-title">Offer Management</h2>
    </div>
    <div class="card" id="space">
      <div class="card-body">
        <div class="row">

    <div class="col-md-12">
    <div class="card mb-4">
     
      <header class="card-header">
        <h4>Edit Coupon</h4>
      </header>
    </div>
    <form id="offerUpdateForm" action="" method="">
      <input type="text" id="offerId" name="id" value="{{offer.[0]._id}}" hidden>
      <div class="form-inline">
      <div class="form-groups col-md-4 mb-3 ">
          <label for="name">Name</label>
          <input type="text" class="form-control" value="{{offer.[0].name}}" id="name" name="name" required>
      </div>
    
         
      <div class="form-group mb-3">
          <label for="description">Description:</label>
          <textarea class="form-control" id="description" value="{{offer.[0].description}}"  name="description">{{offer.[0].description}}</textarea>
      </div>
  
     
  
      <div class="form-groups mb-3">
          <label for="percentage">Discount percentage</label>
          <input type="number" class="form-control" id="percentage" value="{{offer.[0].percentage}}"  name="percentage" required placeholder="%">
      </div>

        <div class="form-groups col-md-3 mb-3">
          <label for="startingDate">End Date:</label>
          <input type="date" class="form-control" id="startingDate" value="{{formatDate offer.[0].startingDate}}"  name="startingDate" required size="20">
      </div>
  
  
      <div class="form-groups col-md-3 mb-3">
          <label for="expiryDate">Start Date:</label>
          <input type="date" class="form-control" id="expiryDate" value="{{formatDate offer.[0].expiryDate}}"  name="expiryDate" required>
      </div>
  
     
  

      
      <div class="form-group mb-3">
      <button type="submit" class="btn btn-primary">Submit</button>
      </div>
    </div>  
    </form>
  
  </div>
 
</div>
</div>
    <!-- card end// -->
  </section>