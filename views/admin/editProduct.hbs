 <section class="content-main">
            <div class="row">
                <div class="col-6">
                    <div class="content-header">
                        <h2 class="content-title">Edit Product</h2>
                        <div>
                            
                            
                        </div>
                    </div>
                </div>
             
            </div>
         
            
            <div class="row">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-body">
                            <form action="/admin/editProduct" method="POST" enctype="multipart/form-data" id="product-edit-form">
                            <input type="hidden" name="pkProductId" value={{product.[0].pkProductId}}>
                            <div class="row">
                                <div class="col-md-3">
                                    <h6>1. General info</h6>
                                </div>
                                <div class="col-md-9">
                              
                                    <div class="mb-4">
                                        
                                        <label class="form-label">Product Title</label>
                                        <input name="strProductName" type="text" placeholder="Type here" class="form-control" value="{{product.[0].strProductName}}">
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Description</label>
                                        <textarea name="strDescription" placeholder="Type here" class="form-control" rows="4">{{product.[0].strDescription}}</textarea>
                                    </div>
                                 
                                </div> <!-- col.// -->
                            </div> <!-- row.// -->
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3">
                                    <h6>2. Pricing</h6>
                                </div>
                                <div class="col-md-9">
                                   
                                        <label class="form-label">Cost in INR</label>
                                        <input name="intPrice" type="number" placeholder="00.0" class="form-control numOnly" value={{product.[0].intPrice}} >
                                    
                                </div> <!-- col.// -->
                            </div> <!-- row.// -->
                            <hr class="mb-4 mt-3">
                             <div class="row">
                                <div class="col-md-3">
                                    <h6>3. Stock</h6>
                                </div>
                                <div class="col-md-9">
                                   
                                        <label class="form-label">Stock</label>
                                        <input name="intStock" type="number" placeholder="0" class="form-control numOnly" value={{product.[0].intStock}}>
                                    
                                </div> <!-- col.// -->
                            </div>
                              <hr class="mb-4 mt-3">
                            <div class="row">
                                <div class="col-md-3">
                                    <h6>4. Category</h6>
                                </div>
                                  
                                          <div class="col-md-5">
                                        <select class="form-select" name="pkCategoryId">
                                         {{#if categories}} {{#each categories}}<option value="{{pkCategoryId}}">{{strCategoryName}}</option>{{/each}}{{/if}}
                                           
                                        </select>
                                    </div>
                                 <!-- col.// -->
                            </div> <!-- row.// -->
                            <hr class="mb-4 mt-3">
                          
                             <div class="row">
                                <div class="col-md-9">
                                    <h6></h6>
                                </div>
                                
                                <div class="col-md-3">
                                    
                                         <button id="product-edit-submit" type="submit" class="btn btn-md rounded font-sm hover-up">Publish</button>
                                    
                                </div>
                                 <!-- col.// -->
                            </div>
                             <div>
                                    <h6
                                 id='errorMessage'
                                   style='color: red; text-align: center'
                                   ></h6>
                                   </div>
                           </form>
                          
                        </div>
                       
 





                    </div>
                      <div class="col-lg-8">
                    <h3 class="text-center">Edit Product Images</h3>
                    <div class="row">
       
        {{#each proImgArray}}
  
<div class="col-4">
    <div class="mb-4">
        <label class="form-label">Image</label>
        <div id="imagePreviewContainer1" class="image-preview-container">
            <img id="previewImage1" src="/uploads/{{pro}}" alt="Selected Image">
        </div>
        <div class="btn-group" role="group">
            <a href="/admin/getProductImageEdit?pkProductId={{pkProductId}}&imgName={{pro}}" class="btn btn-md rounded font-sm hover-up" style="height: 40px; width: 90px; margin-right: 10px;">Edit</a>
            <a onclick="handleDeleteImg('{{pkProductId}}','{{pro}}')" class="btn btn-md rounded font-sm" style="height: 40px; width: 90px;"> <i class="fas fa-trash-alt"></i> Delete</a>
        </div>
    </div>
</div>


    {{/each}}
                  </div>

 
                     </div> 
                    
                </div>          
           </div>

           {{!--add more products  --}}
   <div class="row">
    <h4>Add more</h4>
    
    <form id="add-more-image-form"></form>
    <div id="image-containers">
          
        <div class="input-container">
            <div class="image-container">
                <h3 class="heading">Main Image </h3>
                <input type="file" class="inputImage" accept="image/*" name="Image1">
                <div class="image-preview"></div>
                <button class="cropButton">Crop Image</button>
             
                <div class="cropped-preview"></div>
            </div>
        </div>

         
    </div>
   
 
   <div class="col-md-3">


  <button id="add-more-image-submit" data-product-id="{{product.[0].pkProductId}}"  class="btn btn-md rounded font-sm hover-up">Publish</button>
           <button id="add-more-image" class="btn btn-md rounded font-sm hover-up">Add More Image</button>
       
            
 </div>
        
       
 
</div>


        {{!-- end add more products --}}

            
            
        </section>

        



<style>

.image-container {
      margin-bottom: 20px;
    }
    .image-preview {
      width: 400px;
      height: 300px;
      overflow: hidden;
      display: none; /* Initially hide image preview */
    }
       .cropped-preview {
        width: 300px; /* Set the width of the div */
        height: 400px; /* Set the height of the div */
        border: 1px solid #ccc; /* Optional: Add a border for visualization */
        overflow: hidden; /* Hide any content that overflows the div */
        position: relative; 
        display: none;/* Required for absolute positioning of child elements */
    }

      canvas {
        max-width: 100%; /* Ensure the canvas doesn't exceed the div's width */
        max-height: 100%; /* Ensure the canvas doesn't exceed the div's height */
        position: absolute; /* Position the canvas relative to the div */
        top: 0; /* Position the canvas at the top of the div */
        left: 0; /* Position the canvas at the left of the div */
        right: 0; /* Optionally, constrain the canvas's position to the right */
        bottom: 0; /* Optionally, constrain the canvas's position to the bottom */
        margin: auto; /* Center the canvas horizontally and vertically */
    }
    .cropButton, .heading {
      display: none; /* Initially hide crop button and heading */
    }
















    .numOnly::-webkit-inner-spin-button,
.numOnly::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.numOnly {
  /* Firefox */
  -moz-appearance: textfield;
}

.form-control.error:not(#search-form-control){
        border-color: red;}



/* Optional: Add some styling to the label */
.form-label {
    font-weight: bold;
}
     </style>