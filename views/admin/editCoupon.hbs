
    <section class="content-main">
    <div class="content-header">
      <h2 class="content-title">Coupon Management</h2>
    </div>
    <div class="card" id="space">
      <div class="card-body">
        <div class="row">

    <div class="col-md-12">
    <div class="card mb-4">
     
      <header class="card-header">
        <h4>Create Coupon</h4>
      </header>
    </div>
 <form id="couponUpdateForm" action="" method="">
 
      <input type="text" id="coupnId" name="id" value="{{coupon.[0]._id}}" hidden>
    
      <div class="form-inline">
      <div class="form-groups col-md-4 mb-3 ">
          <label for="name">Name:</label>
          <input type="text" class="form-control" id="name" name="name" value="{{coupon.[0].name}}"  required>
      </div>
      <div class="form-groups col-md-4 mb-3">
        <label for="code">Code:</label>
        <input type="text" class="form-control" id="code" name="code" value="{{coupon.[0].code}}" required>
  </div>
  <div class="form-groups col-md-3 mb-3">
          <button class="btn btn-outline-secondary" type="button" id="generateCodeBtn">Generate Random Code</button>
    
    </div>
      <div class="form-group mb-3">
          <label for="description">Description:</label>
          <textarea class="form-control" id="description" name="description">{{coupon.[0].description}}</textarea>
      </div>
  
     
      <div class="form-groups mb-3">
          <label for="percentage">Discount percentage</label>
          <input type="number" class="form-control" id="percentage" name="percentage" value="{{coupon.[0].discountPercentage}}" required placeholder="%">
      </div>

        <div class="form-groups col-md-3 mb-3">
          <label for="startingDate">Start Date:</label>
          <input type="date" class="form-control" id="startingDate" name="startingDate" value="{{formatDate coupon.[0].startDate}}" required size="20">
      </div>
  
  
      <div class="form-groups col-md-3 mb-3">
          <label for="expiryDate">End Date:</label>
          <input type="date" class="form-control" id="expiryDate" value="{{formatDate coupon.[0].expireDate}}" name="expiryDate" required>
      </div>

        <div class="form-groups mb-3">
          <label for="percentage">Minimum spend</label>
          <input type="number" class="form-control" id="minimum" name="minimum" value="{{coupon.[0].minimumSpend}}" required placeholder="minimum spend">
      </div>
   
      <div class="form-group mb-3">
      <button type="submit" class="btn btn-primary">Submit</button>
      </div>
    </div> 
  
  
  
    </form>
  
  </div>
 
</div>
</div>
    <!-- card end// -->
  </section>