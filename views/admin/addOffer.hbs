  <section class="content-main">
    <div class="content-header">
      <h2 class="content-title">Offer Management</h2>
    </div>
    <div class="card" id="space">
      <div class="card-body">
        <div class="row">

    <div class="col-md-6">
    <div class="card mb-4">
     
      <header class="card-header">
        <h4>Add offer</h4>
      </header>
    </div>
    <form id="offerCreateForm" action="" method="" >
      <div class="form-inline">
      <div class="form-groups col-md-4 mb-3">
          <label for="name">Name:</label>
          <input type="text" class="form-control" id="name" name="name" required>
      </div>
   
      <div class="form-group mb-3">
          <label for="description">Description:</label>
          <textarea class="form-control" id="description" name="description"></textarea>
      </div>
  
     
  
      <div class="form-groups mb-3">
          <label for="percentage">Discount percentage</label>
          <input type="number" class="form-control" id="percentage" name="percentage" required placeholder="%">
      </div>

        <div class="form-groups col-md-3 mb-3">
          <label for="startingDate">End Date:</label>
          <input type="date" class="form-control" id="startingDate" name="startingDate" required size="20">
      </div>
  
  
      <div class="form-groups col-md-3 mb-3">
          <label for="expiryDate">Start Date:</label>
          <input type="date" class="form-control" id="expiryDate" name="expiryDate" required>
      </div>
  
  
      <div class="form-group mb-3">
      <button type="submit" class="btn btn-primary">Submit</button>
      </div>
    </div>  
    </form>
  
  </div>
 
</div>
</div>
    <!-- card end// -->
  </section>