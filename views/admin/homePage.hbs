
        <section class="content-main">
            <div class="content-header">
                <div>
                    <h2 class="content-title card-title">Dashboard </h2>
                    <p>Whole data about your business here</p>
                </div>
                
            </div>
            {{#if orderSalesDetails}}
            {{#each orderSalesDetails}}
            <div class="row">
                <div class="col-lg-3">
                    <div class="card card-body mb-4">
                        <article class="icontext">
                            <span class="icon icon-sm rounded-circle bg-primary-light"><i class="text-primary material-icons md-monetization_on"></i></span>
                            <div class="text">
                                <h6 class="mb-1 card-title">Revenue</h6>
                                <span>₹{{totalDiscountAfterAmount}}</span>
                                <span class="text-sm">
                                    Shipping fees are not included
                                </span>
                            </div>
                        </article>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="card card-body mb-4">
                        <article class="icontext">
                            <span class="icon icon-sm rounded-circle bg-success-light"><i class="text-success material-icons md-local_shipping"></i></span>
                            <div class="text">
                                <h6 class="mb-1 card-title">Orders</h6> <span>{{totalOrders}}</span>
                                <span class="text-sm">
                                    Excluding orders in transit
                                </span>
                            </div>
                        </article>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="card card-body mb-4">
                        <article class="icontext">
                            <span class="icon icon-sm rounded-circle bg-warning-light"><i class="text-warning material-icons md-qr_code"></i></span>
                            <div class="text">
                                <h6 class="mb-1 card-title">Products</h6> <span>10</span>
                                <span class="text-sm">
                                    In 10 Categories
                                </span>
                            </div>
                        </article>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="card card-body mb-4">
                        <article class="icontext">
                            <span class="icon icon-sm rounded-circle bg-info-light"><i class="text-info material-icons md-shopping_basket"></i></span>
                            <div class="text">
                                <h6 class="mb-1 card-title">Overall Discount</h6> <span>{{totalDiscountAmount}}</span>
                                <span class="text-sm">
                                    Based in your local time.
                                </span>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
            {{/each}}
            {{/if }}
              <h5 class="card-title">Sale statistics</h5>
            {{!-- nav link monthly yearly ect --}}
             <div class="container mt-4">
                <ul class="nav nav-pills" id="pills-tab" role="tablist">
                  <li class="nav-item" role="presentation">
                    <a class="nav-link active" id="pills-daily-tab" data-bs-toggle="pill" href="#pills-daily" role="tab" aria-controls="pills-daily" aria-selected="true">Last 30 days</a>
                  </li>
                  <li class="nav-item" role="presentation">
                    <a class="nav-link" id="pills-monthly-tab" onclick="monthlyStat()" data-bs-toggle="pill" href="#pills-monthly" role="tab" aria-controls="pills-monthly" aria-selected="false">Monthly</a>
                  </li>
                  <li class="nav-item" role="presentation">
                    <a class="nav-link" id="pills-yearly-tab" onclick="yearlyStat()" data-bs-toggle="pill" href="#pills-yearly" role="tab" aria-controls="pills-yearly" aria-selected="false">Yearly</a>
                  </li>
                  <li class="nav-item" role="presentation">
                    <a class="nav-link" id="pills-custom-tab"  data-bs-toggle="pill" href="#pills-custom" role="tab" aria-controls="pills-custom" aria-selected="false">Custom</a>
                  </li>
              
                </ul>
                <div class="tab-content" id="pills-tabContent">
                  <div class="tab-pane fade show active" id="pills-daily" role="tabpanel" aria-labelledby="pills-daily-tab">
                     <div class="text-center mt-3 d-flex gap-5 justify-content-center">
<button class="btn btn-primary" onclick="pdfReport('30days')">Pdf report</button>
<button class="btn btn-primary" onclick="excelReport('30days')">Excel report</button>
</div>
                    <div class="d-flex flex-row">
                       
                      

                    <div  class="col-lg-8">
                        <canvas id="myChart"></canvas>
                      </div>

                 
                  </div>
                  </div>

                  <div class="tab-pane fade" id="pills-monthly" role="tabpanel" aria-labelledby="pills-monthly-tab">
                                       <div class="text-center mt-3 d-flex gap-5 justify-content-center">
<button class="btn btn-primary" onclick="pdfReport('monthly')">Pdf report</button>
<button class="btn btn-primary" onclick="excelReport('monthly')">Excel report</button>
</div>
                    <div class="d-flex flex-row">
                      <div id="myChartMonthlyContainer" class="col-lg-8">
                        <canvas id="myChartMonthly"></canvas>
                      </div>
                      
                  </div>
                  </div>
                  <div class="tab-pane fade" id="pills-yearly" role="tabpanel" aria-labelledby="pills-yearly-tab">
                                       <div class="text-center mt-3 d-flex gap-5 justify-content-center">
<button class="btn btn-primary" onclick="pdfReport('yearly')">Pdf report</button>
<button class="btn btn-primary" onclick="excelReport('yearly')">Excel report</button>
</div>
                    <div class="d-flex flex-row">
                      <div class="col-lg-8">
                        <canvas id="myChartYearly"></canvas>
                      </div>
                    
                  </div>
                  </div>
                  <div class="tab-pane fade" id="pills-custom" role="tabpanel" aria-labelledby="pills-custom-tab">
                    <div class="row">
                      <div class="col">
                    <label for="startDate">Start Date:</label>
<input class="form-control" type="date" id="startDateChart" name="startDateChart">
</div>
<div class="col">
<label for="endDate">End Date:</label>
<input class="form-control" type="date" id="endDateChart" name="endDateChart">
</div>
<div class="text-center mt-3 d-flex gap-5 justify-content-center">
<button class="btn btn-primary" onclick="customStat()">Get data</button>
  <button  class="btn btn-primary" id="newButton1" class="btn btn-secondary" style="display: none;" onclick="pdfReport()">Pdf Report</button>
  <button  class="btn btn-primary" id="newButton2" class="btn btn-secondary" style="display: none;" onclick="excelReport()">Excel Report</button>


</div>
                                                           


                    <div class="d-flex flex-row">
                      <div class="col-lg-8">
                        <canvas id="myChartCustom">
 
                        </canvas>

                       
                      </div>
                  
                  </div>
                  </div>
                </div>
              </div>
              </div>
            {{!--end    nav link monthly yearly ect --}}

        {{!--top products chart  --}}
         
          <div class="containter mt-4">
             
             <div class="d-flex flex-row">
                <h5 class="card-title">Top Products</h5>
                      <div class="col-lg-6">
                        <canvas id="topProducts"></canvas>
                      </div>
                  <h5 class="card-title">Top Categories</h5>
                  <div class="col-lg-6">
                        <canvas id="topCategories"></canvas>
                      </div>
                  </div>
                    
          </div>

          {{!-- end top products chart --}}
            <div class="card mb-4">
                <header class="card-header">
                    <h4 class="card-title">Latest orders</h4>
                    <div class="row align-items-center">
                           <div class="col-md-2 col-6">
                            <div class="custom_select" style="display: inline-block;">
                                <select class="sales-report form-select select-nice"  onchange="reportTypeChanged()">
                               
                                    <option value="all">All</option>
                                    <option value="daily">Daily</option>
                                    <option value="weekly">Weekly</option>
                                    <option value="yearly">Yearly</option>
                                    <option value="custom">Custom date</option>
                                </select>
                            </div>
                             
                  
                        </div>
                        <div class="col-md-3 col-12 me-auto mb-md-0 mb-3">
                           
                        </div>
                        <div class="col-md-2 col-6 custom-date" style="display: none;">
                            <input type="date" id="start-date" value="" class="form-control" onchange="updateHref()">
                             
                        </div>

                         <div class="col-md-2 col-6 custom-date" style="display: none;">
                            <input type="date" id="end-date" value="" class="form-control" onchange="updateHref()"  >
                             
                        </div>
                         <div class="col-md-2 col-6 custom-date" style="display: none;">
                       <a id="search-link" href="" style="display: none;" class="btn btn-primary btn-sm rounded custom-search">Search</a>
                             
                        </div>
                     
                       
                          
                    </div>
                </header>
                <div class="card-body">
                   <div class="table-responsive">
                        <div class="table-responsive">
                            <table class="table align-middle table-nowrap mb-0">
                                <thead class="table-light">
                                    <tr>
                                       
                                        <th class="align-middle" scope="col">Order ID</th>
                                        <th class="align-middle" scope="col">Order Date</th>
                                        <th class="align-middle" scope="col">Total</th>
                                        <th class="align-middle" scope="col">Discount Price</th>
                                        <th class="align-middle" scope="col">Payment Status</th>
                                        <th class="align-middle" scope="col">Payment Method</th>
                                       
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#if salesOrder}}
                                    {{#each salesOrder}}
                                    <tr>
                                       
                                        <td><a href="#" class="fw-bold">{{pkOrderId}}</a> </td>
                                        <td>{{formatDate createdDate }}</td>
                                        <td>
                                         {{intTotalOrderPrice}}
                                        </td>
                                        <td>
                                            {{totalAmountAfterDiscount}}
                                        </td>
                                        <td>
                                            <span class="badge badge-pill badge-soft-success">{{strPaymentStatus}}</span>
                                        </td>
                                        <td>
                                            <i class="material-icons md-payment font-xxl text-muted mr-5"></i> {{strPaymentMethod}}
                                        </td>
                                        
                                    </tr>
                                    {{/each}}
                                   {{/if}}
                                </tbody>
                            </table>
                        </div>
                    </div> {{!--  <!-- table-responsive end// --> --}}
                </div>
            </div>
            <div class="pagination-area mt-30 mb-50">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-start">
                           {{paginate currentPage totalPages}}
                    </ul>
                </nav>
            </div>
        </section> <!-- content-main end// -->
     
