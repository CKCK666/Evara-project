 <section class="content-main">
            <div class="content-header">
                <div>
                    <h2 class="content-title card-title">Products List</h2>
                  
                </div>
                <div>
                    
                    <a href="/admin/getAddProduct" class="btn btn-primary btn-sm rounded">Create new</a>
                </div>
            </div>
            <div class="card mb-4">
                {{!-- <header class="card-header">
                    <div class="row align-items-center">
                        <div class="col col-check flex-grow-0">
                            <div class="form-check ms-2">
                                <input class="form-check-input" type="checkbox" value="">
                            </div>
                        </div>
                        <div class="col-md-3 col-12 me-auto mb-md-0 mb-3">
                            <select class="form-select">
                                <option selected>All category</option>
                                <option>Electronics</option>
                                <option>Clothes</option>
                                <option>Automobile</option>
                            </select>
                        </div>
                        <div class="col-md-2 col-6">
                            <input type="date" value="02.05.2021" class="form-control">
                        </div>
                        <div class="col-md-2 col-6">
                            <select class="form-select">
                                <option selected>Status</option>
                                <option>Active</option>
                                <option>Disabled</option>
                                <option>Show all</option>
                            </select>
                        </div>
                    </div>
                </header> <!-- card-header end// --> --}}
<div class="card-body">
    <div class="table-responsive">
         {{#if products}}
        <table class="table table-hover">
            <thead>
                <tr>
                     <th>Sl.No</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Status</th>
                    {{!-- <th>Date</th> --}}
                    <th>Offer</th>
                    <th></th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                
               
                {{#each products}}
                <tr data-product-id="{{_id}}">
                    <td>{{index}}</td>
                    <td>
                
        <img src="/uploads/{{arrayOtherImages.[0]}}" class="img-sm img-thumbnail" alt="Item">
   
                        
                        </td>
                    <td><a href="#">{{strProductName}}</a></td>
                    <td>{{intPrice}}</td>
                   
                    <td><span id="statusId" class="badge rounded-pill {{#eq strStatus 'Blocked'}}alert-warning{{else}}{{#eq strStatus 'Active'}}alert-success{{else}}{{/eq}}{{/eq}}">{{strStatus}}</span></td>
                      <td>{{#if offer}}{{offerPercentage}}% {{else}}NO OFFER{{/if}}</td>
                   <td>{{#if offer}}{{offerName}}{{else}} {{/if}} </td>
                    <td >

                        <a href="/admin/getProductEdit?pkProductId={{pkProductId}}" class="btn btn-md rounded font-sm">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                       
                         <a href="#" onclick="handleBlock('{{pkProductId}}','{{strStatus}}','product')" class="btn btn-md rounded font-sm" style="width: 95px;">
                            <i class="{{#eq strStatus 'Blocked'}}fas fa-check-circle{{else}}fas fa-ban{{/eq}}"></i>{{#eq strStatus 'Blocked'}}Unblock{{else}}Block{{/eq}}
                        </a>
                        {{!-- <a href="#" onclick="handleDelete('{{pkProductId}}', 'product')" class="btn btn-md rounded font-sm">
                            <i class="fas fa-trash-alt"></i> Delete
                        </a> --}}
                        {{#if offer}}
                          <a  onclick="removeOffer('{{pkProductId}}', 'product')" class="btn btn-md rounded font-sm">
                            <i class=""></i> Remove Offer
                        </a>

                         {{else}}
                        <a href="#" onclick="showModal('{{_id}}', 'product')" class="btn btn-md rounded font-sm">
                            <i class=""></i> Apply Offer
                        </a>

                       {{/if}} 
                    </td>
                </tr>
                
                {{/each}}
             
    
              

                <!-- Add more rows as needed -->
        
        </table>
        {{else}}
        <h1 class="text-center">No Data Found!!!!!</h1>
          {{/if}}

    </div>
</div>

            </div> <!-- card end// -->
          
             <div class="pagination-area mt-15 mb-sm-5 mb-lg-0">
                            <nav aria-label="Page navigation example">
                                <ul class="pagination justify-content-start">
                                 {{paginate currentPage totalPages}}
                                </ul>
                            </nav>
                        </div>

            
        <div class="modal fade" id="discountModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" >
          <div class="modal-dialog" role="document">
            
                 {{#if availableOffers}}
                 {{#each availableOffers}}
                  <div class="modal-content rounded-0">
                    <div data-offerid="{{_id}}" style="cursor: pointer;" class="modal-body text-center" aria-hidden="true">
                          <div class="icon text-danger">
                              <i style="font-size: 20px;" class="fas fa-gift"></i>
                          </div>
                          <div class="notice">  
                      
                                  <h2>{{name}}</h2>                          
                                  <h4>{{percentage}}% Discount</h4>
                              <p>Valid from {{formatDate startingDate}} to {{formatDate expiryDate}} </p>
                          </div>
                          <div class="code"></div>
                      </div>
                  </div>
                  {{/each}}
               {{/if}}
          </div>
        </div>
</section>

